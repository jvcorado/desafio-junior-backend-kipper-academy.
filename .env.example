# Configuração local: o Spring não lê .env automaticamente. Veja README.
PORT=8080
SERVER_ADDRESS=127.0.0.1
# Padrão: H2 persistente em ./data. PostgreSQL opcional:
# DATABASE_URL=jdbc:postgresql://127.0.0.1:15432/triagem_java
# DATABASE_USER=triagem_java
# DATABASE_PASSWORD=preencher_apenas_no_ambiente_privado
AI_MODE=demo
DELIVERY_MODE=demo
# Para confirmação durável no Kanban deste painel: DELIVERY_MODE=panel
# Para IA real compatível com tool calling OpenAI Chat Completions:
# AI_MODE=http
# AI_URL=https://api.openai.com/v1/chat/completions
# AI_API_KEY=preencher_apenas_no_ambiente_privado
# AI_MODEL=preencher_com_modelo_compatível
AI_MAX_STEPS=6
# Para encaminhar issues reais, use apenas mensagens fictícias autorizadas:
# DELIVERY_MODE=github
# GITHUB_REPOSITORY=owner/repositorio-de-testes
# GITHUB_TOKEN=preencher_apenas_no_ambiente_privado
# WEBHOOK_TOKEN=preencher_apenas_no_ambiente_privado
